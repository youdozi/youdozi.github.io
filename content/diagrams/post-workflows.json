          ],
          "en": [
            "Read for same actor and run",
            "within 0 to 300 seconds?"
          ],
          "branch": {
            "exit": {
              "ko": "다음 이벤트",
              "en": "Skip event"
            },
            "continue": {
              "ko": "예",
              "en": "Yes"
            },
            "outcome": "complete"
          }
        },
        {
          "kind": "result",
          "ko": [
            "조사 후보 추가",
