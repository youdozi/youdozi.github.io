    {
      "key": "2023-09-10-springboot-intellij-import",
      "title": {
        "en": "Separate build and IDE failures",
        "ko": "빌드와 IDE 오류 구분"
      },
      "description": {
        "en": "Use the Wrapper build to distinguish project failures from IDE setup. HTTP tests use a random port; manual bootRun uses the configured port.",
        "ko": "Wrapper 빌드로 프로젝트 오류와 IDE 설정을 구분합니다. HTTP 테스트는 임의 포트, 수동 bootRun은 지정 포트를 사용합니다."
      },
      "codeContract": [
        {
          "language": "sh",
          "contains": "./gradlew bootRun"
        },
        {
          "language": "java",
          "contains": "class GreetingController"
        }
      ],
      "steps": [
        {
          "en": [
            "Open the Gradle project root",
            "Check JDK and Wrapper settings"
          ],
          "ko": [
            "Gradle 프로젝트 루트 열기",
            "JDK·Wrapper 설정 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Wrapper build fails?",
            "Fix build, dependencies, sources"
          ],
          "ko": [
            "Wrapper 빌드도 실패하는가?",
            "빌드·의존성·소스부터 수정"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Wrapper passes, IDE fails?",
            "Reload Gradle; check run settings"
          ],
          "ko": [
            "Wrapper 통과·IDE만 실패하는가?",
            "Gradle 재로딩·실행 설정 확인"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "HTTP tests check JSON and 404",
            "Use a random server port"
          ],
          "ko": [
            "HTTP 테스트로 JSON·404 확인",
            "임의 서버 포트 사용"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Run the app and request /greeting",
            "Check route and configured port"
          ],
          "ko": [
            "앱 실행 후 /greeting 요청",
            "경로·지정 포트 확인"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2023-09-13-springboot-history",
      "title": {
        "en": "Resolve actual component versions",
        "ko": "실제 구성요소 버전 확인"
      },
      "description": {
        "en": "The flow summarizes dependency inspection rather than a release timeline. Boot, Framework and Lombok have separate version identities and dependency configurations.",
        "ko": "그림은 릴리스 연표가 아닌 의존성 확인 순서입니다. Boot·Framework·Lombok 버전과 의존성 구성은 서로 구분합니다."
      },
      "codeContract": [
        {
          "language": "sh",
          "contains": "dependencyInsight"
        }
      ],
      "steps": [
        {
          "en": [
            "Identify the selected Boot version"
          ],
          "ko": [
            "선택한 Boot 버전 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Inspect dependency management",
            "Do not equate Boot/Framework IDs"
          ],
          "ko": [
            "의존성 관리 설정 확인",
            "Boot·Framework 버전 번호 구분"
          ],
          "kind": "process"
        },
        {
          "en": [
            "dependencyInsight: spring-core",
            "Inspect runtimeClasspath"
          ],
          "ko": [
            "dependencyInsight: spring-core",
            "runtimeClasspath 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "dependencyInsight: lombok",
            "Inspect annotationProcessor"
          ],
          "ko": [
            "dependencyInsight: lombok",
            "annotationProcessor 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Record resolved versions",
            "Assess compatibility for that set"
          ],
          "ko": [
            "실제로 해석된 버전 기록",
            "해당 조합의 호환성 판단"
          ],
          "kind": "result"
        }
      ]
    },
