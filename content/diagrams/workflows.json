        {
          "en": [
            "Skip completed step 1",
            "Rerun step 2 → COMPLETED"
          ],
          "ko": [
            "완료한 Step 1은 건너뜀",
            "Step 2 재실행 → COMPLETED"
          ],
          "kind": "process"
        },
        {
          "en": [
