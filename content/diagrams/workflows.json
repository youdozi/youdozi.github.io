    {
      "key": "2023-09-19-springboot-test-webclient",
      "title": {
        "en": "Validate the HTTP response",
        "ko": "HTTP 응답 계약 확인"
      },
      "description": {
        "en": "The client checks status before media type, releases rejected bodies and decodes supported JSON. StepVerifier checks completion or error as well as emitted values.",
        "ko": "클라이언트는 상태 코드 다음에 미디어 타입을 검사하고 거절한 본문을 해제합니다. StepVerifier는 값뿐 아니라 완료·오류 신호도 확인합니다."
      },
      "codeContract": [
        {
          "language": "java",
          "contains": "exchangeToMono"
        },
        {
          "language": "groovy",
          "contains": "reactor-test"
        }
      ],
      "steps": [
        {
          "en": [
            "Enqueue local mock response",
            "Subscribe to the client request"
          ],
          "ko": [
            "로컬 모의 응답 등록",
            "클라이언트 요청 구독"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Error HTTP status?",
            "Yes: emit exception and stop"
          ],
          "ko": [
            "HTTP 오류 상태인가?",
            "예: 예외 신호를 내고 종료"
          ],
          "kind": "condition",
          "branch": {
            "exit": {
              "en": "Yes",
              "ko": "예"
            },
            "continue": {
              "en": "No",
              "ko": "아니오"
            }
          }
        },
        {
          "en": [
            "application/json or",
            "application/*+json?",
            "Other: release body, then error"
          ],
          "ko": [
            "application/json 또는",
            "application/*+json인가?",
            "그 외: 본문 해제 후 오류 반환"
          ],
          "kind": "condition",
          "branch": {
            "exit": {
              "en": "Other",
              "ko": "그 외"
            },
            "continue": {
              "en": "JSON",
              "ko": "JSON"
            }
          }
        },
        {
          "en": [
            "Only supported types: decode Payload",
            "Observe empty or malformed body"
          ],
          "ko": [
            "허용한 타입: Payload로 디코딩",
            "빈 본문·잘못된 본문 결과 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Verify values and terminal signal",
            "Inspect method, path and Accept"
          ],
          "ko": [
            "값과 종료 신호 검증",
            "메서드·경로·Accept 확인"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2023-10-27-springbatch5-migration",
      "title": {
        "en": "Restart the failed v5 instance",
        "ko": "v5 실패 인스턴스 재시작"
      },
      "description": {
        "en": "This summarizes the fresh-schema v5 restart test, not a v4 database migration. A second execution of the same instance reruns the failed step; the completed step remains complete.",
        "ko": "새 스키마에서 실행한 v5 재시작 테스트 흐름입니다. v4 DB 이관이 아니며 같은 인스턴스의 새 실행은 실패한 Step을 다시 수행합니다."
      },
      "codeContract": [
        {
          "language": "java",
          "contains": "failedInstanceRestartsOnlyItsFailedStep"
        },
        {
          "language": "groovy",
          "contains": "spring-batch-core"
        }
      ],
      "steps": [
        {
          "en": [
            "Create fresh H2 Batch 5 schema",
            "Build identifying job parameters"
          ],
          "ko": [
            "새 H2 Batch 5 스키마 준비",
            "식별용 잡 파라미터 구성"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Launch job: step 1 completes"
          ],
          "ko": [
            "잡 실행: Step 1 완료"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Step 2 fails once",
            "Execution status becomes FAILED"
