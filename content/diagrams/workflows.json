        {
          "en": [
            "Inspect build.gradle and toolchain",
            "Run ./gradlew --version"
          ],
          "ko": [
            "build.gradle·toolchain 확인",
            "./gradlew --version 실행"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Run ./gradlew test",
            "Check context initialization"
          ],
          "ko": [
            "./gradlew test 실행",
            "컨텍스트 초기화 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Run bootRun separately",
            "No controller yet: / may be 404"
          ],
          "ko": [
            "bootRun으로 별도 실행",
            "컨트롤러가 없으면 /는 404 가능"
