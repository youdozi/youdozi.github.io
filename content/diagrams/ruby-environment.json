    {
      "key": "2026-04-07-ruby-rbenv-jekyll-build-troubleshooting",
      "title": {
        "en": "Separate runtime and compiler probes",
        "ko": "실행기와 컴파일러 진단 분리"
      },
      "description": {
        "en": "The Ruby script compares compiler configuration and builds one temporary C++ program. A passing probe does not establish native gem compilation.",
        "ko": "Ruby 스크립트가 컴파일러 설정을 비교하고 임시 C++ 프로그램 하나를 빌드합니다. 통과해도 네이티브 gem 빌드를 입증하지 않습니다."
      },
      "codeContract": [
        {
          "language": "ruby",
          "contains": "Open3.capture3(*compiler"
        },
        {
          "language": "ruby",
          "contains": "PROBE_CXXFLAGS"
        }
      ],
      "steps": [
        {
          "en": [
            "Check Ruby startup and RbConfig"
          ],
          "ko": [
            "Ruby 실행·RbConfig 확인"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Choose the probe compiler",
            "Parse command-scoped flags"
          ],
          "ko": [
            "진단 컴파일러 선택",
            "명령 단위 플래그 해석"
          ],
          "kind": "process"
        },
        {
          "kind": "condition",
          "en": [
            "Temporary C++17 compile succeeded?"
          ],
          "ko": [
            "임시 C++17 컴파일이 성공했는가?"
          ],
          "branch": {
            "exit": {
              "en": "No: stop",
              "ko": "실패: 중단"
            },
            "continue": {
              "en": "Yes",
              "ko": "성공"
            }
          }
        },
        {
          "kind": "condition",
          "en": [
            "Execution succeeded with output 42?"
          ],
          "ko": [
            "실행 성공·출력 42인가?"
