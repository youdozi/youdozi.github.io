{
  "version": 1,
  "diagrams": [
    {
      "key": "2021-07-22-plus-minus",
      "title": {
        "en": "Signed sum",
        "ko": "음양 더하기"
      },
      "description": {
        "en": "Read the same index in both arrays, apply its sign, then sum the signed values.",
        "ko": "두 배열의 같은 인덱스를 읽고 부호를 적용한 뒤 실제 값을 합산합니다."
      },
      "steps": [
        {
          "en": [
            "Generate indices",
            "0 through length - 1"
          ],
          "ko": [
            "인덱스 생성",
            "0부터 길이 - 1까지"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Read absolutes[i] and signs[i]"
          ],
          "ko": [
            "absolutes[i]와 signs[i] 읽기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "true: keep magnitude",
            "false: negate magnitude"
          ],
          "ko": [
            "true면 양수 유지",
            "false면 음수로 변환"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Sum the mapped terms",
            "Return int result"
          ],
          "ko": [
            "변환한 항을 합산",
            "int 결과 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-22-dot-product",
      "title": {
        "en": "Array dot product",
        "ko": "배열 내적"
      },
      "description": {
        "en": "Map each shared index to a product and sum those products. The exercise bounds fit int.",
        "ko": "같은 인덱스의 두 원소를 곱하고 그 결과를 합산합니다. 문제 범위의 결과는 int에 들어갑니다."
      },
      "steps": [
        {
          "en": [
            "Generate shared indices",
            "0 through length - 1"
          ],
          "ko": [
            "공통 인덱스 생성",
            "0부터 길이 - 1까지"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Read a[i] and b[i]"
          ],
          "ko": [
            "a[i]와 b[i] 읽기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Map index to a[i] * b[i]"
          ],
          "ko": [
            "인덱스를 a[i] * b[i]로 변환"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Sum products",
            "Return int result"
          ],
          "ko": [
            "각 곱을 합산",
            "int 결과 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-29-interval-num",
      "title": {
        "en": "An x-spaced sequence",
        "ko": "x 간격 수열"
      },
      "description": {
        "en": "Turn zero-based indices into term numbers, promote x to long before multiplication, and collect in order.",
        "ko": "0부터 시작하는 인덱스를 항 번호로 바꾸고, x를 long으로 승격한 뒤 곱해 순서대로 배열에 담습니다."
      },
      "steps": [
        {
          "en": [
            "Generate indices 0 through n - 1"
          ],
          "ko": [
            "인덱스 0부터 n - 1까지 생성"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Term number = index + 1"
          ],
          "ko": [
            "항 번호 = 인덱스 + 1"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Promote x to long",
            "Then multiply by term number"
          ],
          "ko": [
            "x를 long으로 먼저 승격",
            "그다음 항 번호를 곱함"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Collect terms in encounter order",
            "Return long[]"
          ],
          "ko": [
            "항 번호 순서로 값을 수집",
            "long[] 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-23-number-word",
      "title": {
        "en": "Digit word replacement",
        "ko": "숫자 영단어 치환"
      },
      "description": {
        "en": "Replace the fixed words zero through nine with literal digits, then parse the resulting decimal string.",
        "ko": "zero부터 nine까지 고정된 영단어를 숫자 문자로 치환하고, 남은 십진수 문자열을 정수로 변환합니다."
      },
      "steps": [
        {
          "en": [
            "Start with the input string"
          ],
          "ko": [
            "입력 문자열로 시작"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Visit words zero through nine",
            "in the fixed table"
          ],
          "ko": [
            "고정 표의 zero부터 nine까지",
            "각 영단어를 차례로 선택"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Literal replace word with digit",
            "Keep existing digit characters"
          ],
          "ko": [
            "영단어를 숫자 문자로 리터럴 치환",
            "기존 숫자 문자는 유지"
          ],
          "kind": "process"
        },
        {
          "en": [
            "After all ten replacements",
            "Integer.parseInt → return int"
          ],
          "ko": [
            "10개 영단어의 치환을 마친 뒤",
            "Integer.parseInt → int 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-19-new-id",
      "title": {
        "en": "ID normalization order",
        "ko": "아이디 정규화 순서"
      },
      "description": {
        "en": "The diagram follows the Optional version. The loop version combines filtering and dot collapsing while preserving the same rules.",
        "ko": "그림은 Optional 버전의 순서입니다. 반복문 버전은 허용 문자 필터와 연속 점 제거를 한 번에 처리하며 같은 규칙을 유지합니다."
      },
      "steps": [
        {
          "en": [
            "Lowercase with Locale.ROOT"
          ],
          "ko": [
            "Locale.ROOT로 소문자 변환"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Remove disallowed characters",
            "Keep a-z, 0-9, dot, _, -"
          ],
          "ko": [
            "허용하지 않는 문자 제거",
            "a-z, 0-9, 점, _, - 유지"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Collapse consecutive dots"
          ],
          "ko": [
            "연속된 점을 하나로 축약"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Remove leading and trailing dots"
          ],
          "ko": [
            "맨 앞과 맨 뒤의 점 제거"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Empty? Replace with a"
          ],
          "ko": [
            "빈 문자열이면 a로 대체"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Truncate to at most 15 characters",
            "Then remove a trailing dot"
          ],
          "ko": [
            "최대 15자로 절단",
            "그 뒤 맨 끝의 점 제거"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Length below 3? Repeat last char",
            "Return normalized ID"
          ],
          "ko": [
            "길이가 3 미만이면 마지막 문자 반복",
            "정규화된 아이디 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-20-pair-delete",
      "title": {
        "en": "Adjacent pair removal",
        "ko": "인접한 같은 문자 제거"
      },
      "description": {
        "en": "The stack stores the reduced prefix. Each new character removes the equal top or becomes the new top.",
        "ko": "스택은 처리한 접두사를 축약한 결과입니다. 다음 문자가 꼭대기와 같으면 제거하고, 다르면 새 꼭대기로 넣습니다."
      },
      "steps": [
        {
          "en": [
            "Start with an empty stack"
          ],
          "ko": [
            "빈 스택으로 시작"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Read the next character c"
          ],
          "ko": [
            "다음 문자 c 읽기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Nonempty top equals c?",
            "Yes: pop · No: push c"
          ],
          "ko": [
            "스택이 비어 있지 않고 top = c?",
            "예: pop · 아니오: c를 push"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "More characters?",
            "Yes: repeat · No: finish"
          ],
          "ko": [
            "남은 문자가 있는가?",
            "예: 반복 · 아니오: 종료"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Empty stack: return 1",
            "Otherwise: return 0"
          ],
          "ko": [
            "스택이 비었으면 1 반환",
            "남아 있으면 0 반환"
          ],
          "kind": "result"
        }
      ],
      "loop": {
        "from": 3,
        "to": 1,
        "label": {
          "en": "Yes",
          "ko": "예"
        }
      }
    },
    {
      "key": "2021-07-23-unsuccessful-runner",
      "title": {
        "en": "Name frequency difference",
        "ko": "이름별 빈도 차이"
      },
      "description": {
        "en": "Count every participant, subtract every completion, then return the name whose remaining count is one.",
        "ko": "참가자의 이름별 인원수를 세고 완주자를 한 명씩 뺀 뒤, 남은 인원수가 1인 이름을 반환합니다."
      },
      "steps": [
        {
          "en": [
            "Create a name → count map"
          ],
          "ko": [
            "이름 → 인원수 맵 생성"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Each participant: add 1",
            "Duplicate names share a count"
          ],
          "ko": [
            "참가자마다 1 증가",
            "동명이인은 같은 빈도에 누적"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Each completion: subtract 1"
          ],
          "ko": [
            "완주자마다 1 감소"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Scan remaining counts",
            "Find the single count of 1"
          ],
          "ko": [
            "남은 빈도 순회",
            "유일하게 1인 항목 찾기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Return that name",
            "One missing runner is guaranteed"
          ],
          "ko": [
            "그 이름 반환",
            "미완주자 1명이라는 조건 사용"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-29-ponkemon",
      "title": {
        "en": "Distinct types and selection slots",
        "ko": "서로 다른 종류와 선택 개수"
      },
      "description": {
        "en": "Distinct types and the N/2 selection limit are both upper bounds. Their minimum is achievable under this exercise contract.",
        "ko": "종류 수와 N/2 선택 제한은 모두 상한입니다. 문제 조건에서는 두 값의 최솟값을 달성할 수 있습니다."
      },
      "steps": [
        {
          "en": [
            "Visit every type ID"
          ],
          "ko": [
            "모든 종류 ID 읽기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Insert into a HashSet",
            "Duplicates do not add types"
          ],
          "ko": [
            "HashSet에 추가",
            "중복 ID는 종류 수를 늘리지 않음"
          ],
          "kind": "process"
        },
        {
          "en": [
            "kinds = set size",
            "slots = nums.length / 2"
          ],
          "ko": [
            "kinds = 집합의 크기",
            "slots = nums.length / 2"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Return min(kinds, slots)",
            "A count, not a chosen subset"
          ],
          "ko": [
            "min(kinds, slots) 반환",
            "선택한 배열이 아닌 종류 수"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-07-24-fail-percentage",
      "title": {
        "en": "Failure rate ranking",
        "ko": "실패율 정렬"
      },
      "description": {
        "en": "Save reached counts before subtracting stopped players. Compare rates by long cross-products, then break ties by stage number.",
        "ko": "멈춘 인원을 빼기 전에 도달 인원을 저장합니다. long 교차곱으로 비율을 비교하고 동률이면 스테이지 번호로 정렬합니다."
      },
      "steps": [
        {
          "en": [
            "Count stopped players per stage",
            "Include players at N + 1"
          ],
          "ko": [
            "스테이지별 멈춘 인원 집계",
            "N + 1의 완료 인원도 집계"
          ],
          "kind": "process"
        },
        {
          "en": [
            "remaining = all player count",
            "Visit stages 1 through N"
          ],
          "ko": [
            "remaining = 전체 인원",
            "스테이지 1부터 N까지 순회"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Save reached = remaining",
            "Then subtract stopped players"
          ],
          "ko": [
            "먼저 reached = remaining 저장",
            "그 뒤 멈춘 인원을 빼기"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Zero reached: rate is zero",
            "Use denominator 1 for comparison"
          ],
          "ko": [
            "도달 인원이 0이면 실패율 0",
            "비교용 분모는 1 사용"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Sort by long cross-products",
            "Higher rate first; tie: lower ID"
          ],
          "ko": [
            "long 교차곱으로 내림차순 정렬",
            "동률이면 작은 번호 우선"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Return ordered stage IDs"
          ],
          "ko": [
            "정렬된 스테이지 번호 배열 반환"
          ],
          "kind": "result"
        }
      ]
    },
    {
      "key": "2021-08-17-cache",
      "title": {
        "en": "Access-ordered LRU cache",
        "ko": "접근 순서 기반 LRU 캐시"
      },
      "description": {
        "en": "Capacity zero returns immediately. Otherwise get/put refresh recency, and an overflow evicts the least recently accessed key.",
        "ko": "용량 0은 즉시 반환합니다. 그 외에는 get·put으로 접근 순서를 갱신하고 용량을 넘으면 가장 오래 접근하지 않은 키를 제거합니다."
      },
      "steps": [
        {
          "en": [
            "Capacity 0: return 5 × requests",
            "Otherwise follow the arrows"
          ],
          "ko": [
            "용량 0이면 5 × 요청 수 반환",
            "그 외에는 다음 단계로 진행"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "Create access-ordered map once",
            "Initialize cost = 0"
          ],
          "ko": [
            "접근 순서 맵을 한 번 생성",
            "cost = 0으로 초기화"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Read next city",
            "Lowercase with Locale.ROOT"
          ],
          "ko": [
            "다음 도시 읽기",
            "Locale.ROOT로 소문자 변환"
          ],
          "kind": "process"
        },
        {
          "en": [
            "get(key): hit adds 1, miss adds 5",
            "put(key) makes it most recent"
          ],
          "ko": [
            "get(key): 적중 +1, 미스 +5",
            "put(key)로 가장 최근 접근 표시"
          ],
          "kind": "process"
        },
        {
          "en": [
            "Over capacity? Remove first key",
            "Otherwise retain all keys"
          ],
          "ko": [
            "용량을 넘으면 첫 번째 키 제거",
            "넘지 않으면 모든 키 유지"
          ],
          "kind": "condition"
        },
        {
          "en": [
            "More cities?",
            "Yes: repeat · No: return cost"
          ],
          "ko": [
            "남은 도시가 있는가?",
            "예: 반복 · 아니오: 비용 반환"
          ],
          "kind": "result"
        }
      ],
      "loop": {
        "from": 5,
        "to": 2,
        "label": {
          "en": "Yes",
          "ko": "예"
        }
      }
    }
  ]
}
