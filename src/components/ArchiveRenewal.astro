---
import type {RenewalData} from '../lib/renewal-schema';
import labels from '../lib/archive-ui.json';
import type {Language} from '../lib/content';
interface Props {article:RenewalData;lang:Language;edition:RenewalData['editions']['en'];}
const {article,lang,edition}=Astro.props;
const t=labels[lang];
const additionalSources=[...new Set(article.documents.map(document=>document.url))].filter(url=>url!==article.url);
---
<p class="entry-meta" data-archive-date={article.archiveDate}>{t.newsDate}: <time datetime={article.archiveDate}>{article.archiveDate}</time></p>
{[...edition.claims,...edition.followUp].map(c=><p>{c.text}</p>)}
<p><a class="source-link" href={article.url} rel="noopener noreferrer">{t.original} ↗</a>{additionalSources.map(url=><span> · <a href={url} title={url} rel="noopener noreferrer">{new URL(url).hostname} ↗</a></span>)}</p>
