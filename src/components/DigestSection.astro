---
import { text, formatDate, type NativeLanguage } from '../lib/content';
import CandidateReview from './CandidateReview.astro';
import type { DigestArticle } from '../lib/digest-schema';
interface Props { article: DigestArticle; index: number; lang: NativeLanguage; reviewMode?:boolean; }
const { article, index, lang } = Astro.props;
const additionalSources=[...new Set(article.documents.map(document=>document.url))].filter(url=>url!==article.url);
---
<section class="digest-article">
  <div class="entry-meta"><span data-source>{article.source}</span><time data-date datetime={article.publishedAt.toISOString()}>{formatDate(article.publishedAt, lang)}</time></div>
  <h2 data-title>{index+1}. {article.editions[lang].title}</h2>
  {Astro.props.reviewMode ? <p data-summary>{article.editions[lang].summary}</p> : article.editions[lang].claims.map(claim => <p>{claim.text}</p>)}
  {Astro.props.reviewMode && <CandidateReview article={article} lang={lang} />}
  {!Astro.props.reviewMode && article.editorial?.experiment.status==='tested' && <p><a href={article.editorial.experiment.reportUrl!}>{lang==='ko'?'실험 환경·결과 보기':'Experiment environment and results'} ↗</a></p>}
  <a class="source-link" data-source-link href={article.url} rel="noopener noreferrer">{text[lang].source} ↗</a>
  {additionalSources.map(url=><span> · <a href={url} title={url} rel="noopener noreferrer">{new URL(url).hostname} ↗</a></span>)}
  {Astro.props.reviewMode && <details><summary>{lang === 'en' ? 'Source evidence' : '원문 인용 근거'}</summary><div data-claims>{article.editions[lang].claims.map(claim => <div><p>{claim.text}</p>{claim.evidence.map(e => <blockquote><p>{e.quote}</p><a href={article.documents[e.document_id].url} rel="noopener noreferrer">{lang === 'en' ? 'Evidence source' : '인용 출처'} ↗</a></blockquote>)}</div>)}</div></details>}
</section>
