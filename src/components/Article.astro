---
import Comments from './Comments.astro';
import type {NativeLanguage} from '../lib/locales';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntryList from './EntryList.astro';
import DigestSection from './DigestSection.astro';
import ArchiveRenewal from './ArchiveRenewal.astro';
import { relatedEntries } from '../lib/related';
import {authorData,authorPath} from '../lib/author';
import {categoryGuide,additionalArticleGuides} from '../lib/technical-guides';
import { entries, text, alternateLinks, formatDate, taxonomyUrl, type Entry } from '../lib/content';
interface Props { entry: Entry; }
const { entry } = Astro.props;
const lang = entry.language;
const all = await entries();
const rendered = entry.post ? await render(entry.post) : undefined;
const Content = rendered?.Content;
const canonical = new URL(entry.url, Astro.site).href;
const articleData: Record<string, unknown>[] = entry.reviewStatus === 'example' ? [] : [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${canonical}#article`, mainEntityOfPage: canonical, url: canonical,
    headline: entry.title, description: entry.description, inLanguage: lang, datePublished: entry.publishedAt.toISOString(), dateModified: (entry.updatedAt || entry.publishedAt).toISOString(),
    author: authorData(lang),
    publisher: authorData(lang),
    ...(entry.renewal ? {isBasedOn:entry.renewal.data.url,citation:entry.renewal.data.documents.map(d=>d.url),temporalCoverage:entry.renewal.data.archiveDate} : {}),
    ...(entry.post?.data.image ? { image: new URL(entry.post.data.image, Astro.site).href } : {}) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: text[lang].home, item: new URL(`/${lang}/`, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: text[lang][entry.kind === 'digest' ? 'digest' : 'posts'], item: new URL(`/${lang}/${entry.kind === 'digest' ? 'digest' : 'posts'}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.title, item: canonical },
  ] },
];
const related = relatedEntries(entry, all);
const visibleTags = entry.tags.filter(tag => tag !== 'archive-renewal');
const visibleCategories = entry.categories.filter(category => !['dev', 'digest'].includes(category) &&
  (categoryGuide(category,lang,all) || !visibleTags.includes(category)));
const additionalGuides=additionalArticleGuides(entry,all);
const hasTopics = all.some(candidate => candidate.language === lang && candidate.tags.some(tag => tag !== 'archive-renewal'));
---
<Base title={entry.title} description={entry.description} lang={lang} structuredData={articleData} noindex={entry.reviewStatus === 'example'} alternates={alternateLinks(entry, all)}>
  <article class="article">
    <header class="article-heading"><a class="eyebrow" href={`/${lang}/${entry.kind === 'digest' ? 'digest' : 'posts'}/`}>← {text[lang][entry.kind === 'digest' ? 'digest' : 'posts']}</a><h1>{entry.title}</h1><div class="entry-meta"><time datetime={entry.publishedAt.toISOString()}>{formatDate(entry.publishedAt, lang)}</time><a class="author-link" href={authorPath(lang)} rel="author" lang={lang==='ko'?'ko':'en'}>youdozi</a></div></header>
    {entry.reviewStatus === 'example' && <aside class="notice">예제 데이터 — 실제 뉴스로 취급하지 마세요.</aside>}
    <div class="prose">
      {Content && <Content />}
      {entry.renewal && <ArchiveRenewal article={entry.renewal.data} lang={lang} edition={entry.renewalEdition!} />}
      {entry.digest && entry.digest.data.articles.map((article, index) => <DigestSection article={article} index={index} lang={lang as NativeLanguage} />)}
    </div>
    {(hasTopics || visibleCategories.length > 0) && <footer class="article-footer"><nav class="chips" aria-label={text[lang].tags}>{hasTopics && <a href={`/${lang}/tags/`}>{text[lang].tags}</a>}{visibleCategories.map(category => <a href={taxonomyUrl(lang, 'categories', category)}>{categoryGuide(category,lang,all)?.label || category}</a>)}{additionalGuides.map(guide => <a href={guide.url}>{guide.label}</a>)}{visibleTags.map(tag => <a href={taxonomyUrl(lang, 'tags', tag)}>#{tag}</a>)}</nav></footer>}
  </article>
  {related.length > 0 && <section class="related"><h2>{text[lang].related}</h2><EntryList items={related} lang={lang} /></section>}
  <Comments entry={entry} />
</Base>
