---
import labels from '../../lib/archive-ui.json';
import searchUi from '../../lib/search-ui.json';
import Base from '../../layouts/Base.astro';
import { publishedLanguages, text, type Language } from '../../lib/content';
export async function getStaticPaths() { return (await publishedLanguages()).map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
---
<Base title={text[lang].search} lang={lang} noindex alternates={(await publishedLanguages()).map(language => ({ language, url: `/${language}/search/` }))}>
  <section class="page-heading"><span class="eyebrow">{text[lang].overview}</span><h1>{text[lang].results}</h1></section>
  <label class="eyebrow" for="search">{text[lang].searchHint}</label>
  <input id="search" class="search-box" type="search" autocomplete="off" placeholder={text[lang].searchHint} data-lang={lang} aria-controls="results" aria-describedby="status" />
  <p id="status" role="status" aria-live="polite" data-empty={text[lang].noResults} data-error={labels[lang].searchError} data-loading={searchUi[lang].loading} data-count={searchUi[lang].count}></p>
  <button id="search-retry" class="button" type="button" hidden>{searchUi[lang].retry}</button>
  <div id="results" aria-busy="false"></div>
  <noscript>{labels[lang].noScript}</noscript>
</Base>
<script>
  import '../../scripts/search';
</script>
