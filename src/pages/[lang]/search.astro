---
import labels from '../../lib/archive-ui.json';
import Base from '../../layouts/Base.astro';
import { publishedLanguages, text, type Language } from '../../lib/content';
export async function getStaticPaths() { return (await publishedLanguages()).map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
---
<Base title={text[lang].search} lang={lang} noindex alternates={(await publishedLanguages()).map(language => ({ language, url: `/${language}/search/` }))}>
  <section class="page-heading"><span class="eyebrow">{text[lang].overview}</span><h1>{text[lang].results}</h1></section>
  <label class="eyebrow" for="search">{text[lang].searchHint}</label>
  <input id="search" class="search-box" type="search" autocomplete="off" placeholder={text[lang].searchHint} data-lang={lang} />
  <p id="status" role="status" aria-live="polite" data-empty={text[lang].noResults} data-error={labels[lang].searchError}></p><div id="results"></div>
  <noscript>{labels[lang].noScript}</noscript>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#search')!;
  const results = document.querySelector<HTMLDivElement>('#results')!;
  const status = document.querySelector<HTMLParagraphElement>('#status')!;
  type Item = { title: string; url: string; description: string; content: string; tags: string[] };
  let index: Promise<Item[]> | undefined;
  let version = 0;
  async function search() {
    const current = ++version;
    const terms = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
    results.replaceChildren(); status.textContent = '';
    if (!terms.length) return;
    try {
      index ??= fetch(`/${input.dataset.lang}/search-index.json`).then(r => { if (!r.ok) throw new Error('index'); return r.json(); });
      const items = await index;
      if (current !== version) return;
      const matches = items.filter(item => terms.every(term => `${item.title} ${item.tags.join(' ')} ${item.content}`.toLocaleLowerCase().includes(term))).slice(0,50);
      status.textContent = matches.length ? `${matches.length}` : status.dataset.empty!;
      for (const item of matches) {
        const article = document.createElement('article'); article.className = 'search-result';
        const heading = document.createElement('h2'); const link = document.createElement('a'); link.href = item.url; link.textContent = item.title;
        const description = document.createElement('p'); description.textContent = item.description;
        heading.append(link); article.append(heading, description); results.append(article);
      }
    } catch { if (current === version) { index = undefined; status.textContent = status.dataset.error!; } }
  }
  input.addEventListener('input', search);
</script>
