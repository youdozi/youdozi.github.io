---
import Listing from '../../../components/Listing.astro';
import { entries, publishedLanguages, text, type Language } from '../../../lib/content';
export async function getStaticPaths() {
  const all = await entries();
  return (await publishedLanguages()).flatMap(lang => Array.from({length: Math.max(0,Math.ceil(all.filter(e => e.language === lang).length/12)-1)}, (_,i) => ({ params: { lang, page: String(i+2) } })));
}
const lang = Astro.params.lang as Language;
---
<Listing items={(await entries()).filter(e => e.language === lang)} lang={lang} title={text[lang].recent} page={Number(Astro.params.page)} root={`/${lang}/`} />
