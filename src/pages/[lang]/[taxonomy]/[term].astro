---
import {categoryName} from '../../../lib/category-guide';
import Listing from '../../../components/Listing.astro';
import CategoryGuide from '../../../components/CategoryGuide.astro';
import {categoryGuide,categoryGuideAlternates,guideTerms} from '../../../lib/technical-guides';
import { entries, publishedLanguages, taxonomySlug, taxonomyUrl, type Language } from '../../../lib/content';
export async function getStaticPaths() {
  const all = await entries();
  return (await publishedLanguages()).flatMap(lang => (['categories','tags'] as const).flatMap(taxonomy => {
    const terms = new Set(all.filter(e => e.language === lang).flatMap(e => e[taxonomy]));
    if (taxonomy === 'categories') {
      for (const term of guideTerms) if (!terms.has(term) && categoryGuide(term,lang,all)) terms.add(term);
    }
    return [...terms].map(term => ({ params: { lang, taxonomy, term: taxonomySlug(term) }, props: { term } }));
  }));
}
const lang = Astro.params.lang as Language;
const kind = Astro.params.taxonomy as 'categories' | 'tags';
const term = Astro.props.term as string;
const all = await entries();
const guide = kind === 'categories' ? categoryGuide(term,lang,all) : undefined;
const alternates = guide ? categoryGuideAlternates(term,all) : [];
---
{guide ? <CategoryGuide guide={guide} alternates={alternates} /> : <Listing items={all.filter(e => e.language === lang && e[kind].includes(term))} lang={lang} title={kind==='categories'?categoryName(term,lang):term} root={taxonomyUrl(lang,kind,term)} />}
