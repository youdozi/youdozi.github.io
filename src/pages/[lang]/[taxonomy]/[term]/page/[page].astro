---
import Listing from '../../../../../components/Listing.astro';
import { entries, publishedLanguages, taxonomySlug, taxonomyUrl, type Language } from '../../../../../lib/content';
export async function getStaticPaths() {
  const all = await entries();
  return (await publishedLanguages()).flatMap(lang => (['categories','tags'] as const).flatMap(taxonomy => [...new Set(all.filter(e => e.language === lang).flatMap(e => e[taxonomy]))].flatMap(term => Array.from({ length: Math.max(0,Math.ceil(all.filter(e => e.language === lang && e[taxonomy].includes(term)).length/12)-1) }, (_,i) => ({ params: { lang, taxonomy, term: taxonomySlug(term), page: String(i+2) }, props: { term } })))));
}
const lang = Astro.params.lang as Language;
const kind = Astro.params.taxonomy as 'categories' | 'tags';
const term = Astro.props.term as string;
---
<Listing items={(await entries()).filter(e => e.language === lang && e[kind].includes(term))} lang={lang} title={term} root={taxonomyUrl(lang,kind,term)} page={Number(Astro.params.page)} />
