---
import Listing from '../../../components/Listing.astro';
import { entries, languages, text, type Language } from '../../../lib/content';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const section = 'posts' as const;
---
<Listing items={(await entries()).filter(e => e.language === lang && e.kind === (section === 'posts' ? 'post' : 'digest'))} lang={lang} title={text[lang][section]} root={`/${lang}/${section}/`} alternates={languages.map(language => ({ language, url: `/${language}/${section}/` }))} />
