---
import Listing from '../../../components/Listing.astro';
import {sectionAlternates} from '../../../lib/discovery';
import { entries, publishedLanguages, text, type Language } from '../../../lib/content';
export async function getStaticPaths() { return (await publishedLanguages()).map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const section = 'digest' as const;
const all = await entries();
const alternates = sectionAlternates(all,'digest');
---
<Listing items={all.filter(e => e.language === lang && e.kind === 'digest')} lang={lang} title={text[lang][section]} root={`/${lang}/${section}/`} alternates={alternates} />
