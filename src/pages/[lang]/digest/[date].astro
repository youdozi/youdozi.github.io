---
import Article from '../../../components/Article.astro';
import { entries } from '../../../lib/content';
export async function getStaticPaths() { return (await entries(true)).filter(e => e.kind === 'digest').map(entry => ({ params: { lang: entry.language, date: entry.slug }, props: { entry } })); }
---
<Article entry={Astro.props.entry} />
