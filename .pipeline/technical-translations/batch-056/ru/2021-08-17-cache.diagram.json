{
  "key": "2021-08-17-cache",
  "language": "ru",
  "title": "LRU-кеш с порядком доступа",
  "description": "При нулевой ёмкости результат возвращается сразу. Иначе get/put обновляют порядок обращений, а переполнение вытесняет ключ с самым давним доступом.",
  "steps": [
    {
      "kind": "condition",
      "lines": [
        "Ёмкость 0: вернуть 5 × запросы",
        "Иначе следовать стрелкам"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Один раз создать map доступа",
        "Инициализировать cost = 0"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Прочитать следующий город",
        "Нижний регистр: Locale.ROOT"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "get(key): попадание +1",
        "Промах: +5",
        "put(key): последний доступ"
      ]
    },
    {
      "kind": "condition",
      "lines": [
        "Сверх ёмкости? Удалить первый",
        "Иначе сохранить все ключи"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "Ещё есть города?",
        "Да: повторить",
        "Нет: вернуть стоимость"
      ]
    }
  ],
  "loop": {
    "from": 5,
    "to": 2,
    "label": "Да"
  }
}
