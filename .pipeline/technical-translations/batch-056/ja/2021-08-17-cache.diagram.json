{
  "key": "2021-08-17-cache",
  "language": "ja",
  "title": "アクセス順の LRU キャッシュ",
  "description": "容量ゼロなら直ちに返します。それ以外では get/put で最近のアクセス順を更新し、容量超過時に最も長く未アクセスのキーを削除します。",
  "steps": [
    {
      "kind": "condition",
      "lines": [
        "容量 0：5 × リクエスト数を返す",
        "それ以外は矢印に沿って進む"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "アクセス順マップを一度作る",
        "cost = 0 に初期化"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "次の都市を読む",
        "Locale.ROOT で小文字化"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "get(key)：ヒット +1、ミス +5",
        "put(key) で最新にする"
      ]
    },
    {
      "kind": "condition",
      "lines": [
        "容量超過なら最初のキーを削除",
        "それ以外はすべて保持"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "まだ都市がある？",
        "はい：反復／いいえ：コストを返す"
      ]
    }
  ],
  "loop": {
    "from": 5,
    "to": 2,
    "label": "はい"
  }
}
