  "title": "一回の移動処理",
  "description": "位置、方向、経過時間を受け取り、方向ベクトルの長さを制限し、速度と時間を適用して点を範囲内に収め、新しい位置を返す",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "位置・方向・経過時間を入力"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "方向ベクトルの長さを",
        "最大 1 に制限"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "速度と経過時間を適用",
        "位置に変位を加算"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "点を長方形の範囲内に制限"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "新しい位置を返す"
      ]
    }
  ]
}
