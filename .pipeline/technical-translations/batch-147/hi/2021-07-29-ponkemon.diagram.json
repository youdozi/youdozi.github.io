  "title": "कितने अलग प्रकार चुन सकते हैं?",
  "description": "अलग-अलग प्रकारों की संख्या और N/2 जगहों की सीमा में से छोटा मान चुनें। अभ्यास की शर्तों में यह मान हासिल किया जा सकता है।",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "हर वस्तु का प्रकार देखें"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "उसका आईडी HashSet में डालें",
        "दोहराए गए आईडी से आकार नहीं बढ़ता"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "kinds = सेट का आकार",
        "slots = nums.length / 2"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "min(kinds, slots) लौटाएँ",
        "उत्तर प्रकारों की संख्या है"
      ]
    }
  ]
}
