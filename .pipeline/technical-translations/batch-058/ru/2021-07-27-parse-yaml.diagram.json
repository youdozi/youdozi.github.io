{
  "key": "2021-07-27-parse-yaml",
  "language": "ru",
  "title": "Проверка YAML до exec",
  "description": "Разберите и проверьте целочисленный порт до экспорта SERVER_PORT. Ошибка загрузчика не даёт запустить целевую команду; exec сохраняет её статус.",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "Прочитать YAML через safe_load"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Проверить отображения корня и server"
      ]
    },
    {
      "kind": "condition",
      "lines": [
        "Требовать целый порт 1..65535",
        "Неверный ввод: остановиться с ошибкой"
      ],
      "branch": {
        "outcome": "error",
        "exit": "Неверно",
        "continue": "Верно"
      }
    },
    {
      "kind": "result",
      "lines": [
        "Только верный порт:",
        "экспорт SERVER_PORT",
        "exec с аргументами в кавычках"
      ]
    }
  ]
}
