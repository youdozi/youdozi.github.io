{
  "key": "2026-10-27-jenkins-home-backup-restore",
  "language": "ru",
  "title": "Восстановление в другой том",
  "description": "Лаборатория восстанавливает архив и отдельный master.key, проверяя HTTP и выбранные файлы. Она не доказывает восстановление рабочих нагрузок и внешних систем.",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "Подготовить контроллер, остановить"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Архив home без master.key",
        "Ключ скопировать отдельно"
      ]
    },
    {
      "kind": "condition",
      "lines": [
        "master.key исключён из архива?"
      ],
      "branch": {
        "outcome": "error",
        "exit": "Нет: ошибка",
        "continue": "Да"
      }
    },
    {
      "kind": "process",
      "lines": [
        "Распаковать в новый том",
        "Отдельно вернуть master.key"
      ]
    },
    {
      "kind": "condition",
      "lines": [
        "HTTP, маркер и пароль совпали?"
      ],
      "branch": {
        "outcome": "error",
        "exit": "Нет: ошибка",
        "continue": "Да"
      }
    },
    {
      "kind": "result",
      "lines": [
        "Сообщить ограниченный результат",
        "Удалить данные и временные файлы"
      ]
    }
  ]
}
