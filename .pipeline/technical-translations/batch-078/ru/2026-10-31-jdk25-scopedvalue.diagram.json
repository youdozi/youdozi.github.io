{
  "key": "2026-10-31-jdk25-scopedvalue",
  "title": "Контекст запроса и восстановление",
  "description": "Соответствует handleRequest в виртуальном потоке; нормальный и аварийный выход из вложенной области восстанавливают внешнюю привязку. Обычный дочерний поток её не наследует.",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "Начать запрос в виртуальном потоке",
        "Убедиться: CONTEXT не привязан"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "call(): tenant-a / trace-123",
        "Прочитать контекст в service()"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Вложенный run(): читать tenant-b",
        "Вернуться и увидеть tenant-a"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Вложенный run(): исключение",
        "Перехват снаружи; снова tenant-a"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "Запустить обычный дочерний поток",
        "Нет привязки; дождаться join"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "Вернуться из внешнего call()",
        "Нет привязки; get() — исключение"
      ]
    }
  ],
  "language": "ru"
}
