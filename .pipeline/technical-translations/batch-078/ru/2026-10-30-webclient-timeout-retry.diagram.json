{
  "key": "2026-10-30-webclient-timeout-retry",
  "title": "Операторы тайм-аута и повторов",
  "description": "Читайте конвейер операторов сверху вниз. Общий тайм-аут охватывает попытки и задержки повторов. Два повтора разрешены только для HTTP 503.",
  "steps": [
    {
      "kind": "process",
      "lines": [
        "GET /value",
        "retrieve → декодировать String"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "timeout(attemptLimit)",
        "Новый бюджет каждой попытки"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "retryWhen: только HTTP 503",
        "Задержка; до двух повторов"
      ]
    },
    {
      "kind": "process",
      "lines": [
        "timeout(totalLimit)",
        "Все попытки и задержки"
      ]
    },
    {
      "kind": "result",
      "lines": [
        "Подписчик получает",
        "значение / завершение",
        "или последнюю ошибку"
      ]
    }
  ],
  "language": "ru"
}
