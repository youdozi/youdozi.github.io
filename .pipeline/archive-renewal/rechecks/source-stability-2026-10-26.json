        "editions": {
          "en": {
            "title": "Cloud-security podcast: attributed isolation and learning advice",
            "claims": [
              {
                "text": "In the transcript, Edera co-founder Alex Zenla describes a zone abstraction for isolating workloads inside virtual machines. This is the vendor speaker’s account of the design, not an independently tested security boundary.",
                "evidence": [
                  {
                    "document_id": 0,
                    "quote": "we have this concept called a zone that allows you to run isolated workloads inside of a safe virtual machine."
                  }
                ]
