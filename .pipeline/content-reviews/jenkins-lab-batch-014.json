    "findings": [
      {
        "issue": "Rolling image tags and copied pull/password logs do not identify a reproducible experiment.",
        "resolution": "Resolve an image digest once per run, record the actual Jenkins version, compare passwords in memory and never log them."
      },
      {
        "issue": "Container recreation against one volume is not a backup test.",
        "resolution": "Add a separate stopped-source archive and new-volume restoration exercise."
      },
      {
        "issue": "A single full-home backup would include the controller master key.",
        "resolution": "Exclude secrets/master.key from the archive, check the member list and copy/apply the key through a separate private temporary location."
      },
      {
        "issue": "Every Korean manuscript was assumed to be a legacy migration.",
        "resolution": "Allow new posts without invented legacy metadata while comparing the exact set of original source paths to all preserved legacy editions."
      },
      {
        "issue": "Local Docker CLI is available but its engine is stopped.",
        "resolution": "Do not alter the local engine; locally parse and compare paired files, and require actual disposable Docker execution in hosted CI before completion."
      },
      {
        "issue": "Actual hosted startup reset the HTTP connection before the first response; URLError alone did not catch it.",
        "resolution": "Retry ConnectionError and HTTPException within the existing deadline. Two source-extracted tests cover reset/refusal/503/disconnection recovery, missing-header timeout and propagation of programming errors."
      }
    ],
