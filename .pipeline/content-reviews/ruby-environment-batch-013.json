    "findings": [
      {
        "issue": "The legacy installation commands could be read as a current supported-version recommendation.",
        "resolution": "Record Ruby3.2.2 as an EOL compatibility reproduction; link maintenance status and require selecting supported versions separately."
      },
      {
        "issue": "Installed gems and bundle-visible gems were conflated.",
        "resolution": "Use a separate two-gem Gemfile; an observed missing-GFM failure is distinguished from the successful declared bundle."
      },
      {
        "issue": "Jekyll3 layout lookup and macOS /var symlinks leaked host paths into the temporary fixture.",
        "resolution": "Use File.realpath, disable default config discovery and render from the fixture source directory."
      },
      {
        "issue": "A successful standalone compiler probe could be mistaken for a native gem rebuild.",
        "resolution": "Report its exact output and selected compiler separately from RbConfig and limit the claim to that temporary C++ program."
      },
      {
        "issue": "A linear compiler flow could imply continuation after failure.",
        "resolution": "Show explicit stopped branches for compilation or execution/output failure."
      }
