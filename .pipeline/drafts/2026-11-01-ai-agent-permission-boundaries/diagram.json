          "branch": {
            "exit": {
              "ko": "승인대기",
              "en": "approval"
            },
            "continue": {
              "ko": "예",
              "en": "yes"
            }
          }
        },
        {
          "kind": "condition",
          "ko": [
            "주체·요청·산출물이 같은가?"
          ],
          "en": [
            "Worker and request match?"
          ],
          "branch": {
            "exit": {
              "ko": "범위거부",
              "en": "deny scope"
            },
            "continue": {
              "ko": "예",
              "en": "yes"
            }
          }
        },
        {
          "kind": "condition",
          "ko": [
            "현재 시각 < 만료 시각인가?"
          ],
          "en": [
            "Now before expiry?"
          ],
          "branch": {
            "exit": {
              "ko": "만료거부",
              "en": "expired"
            },
            "continue": {
              "ko": "예",
              "en": "yes"
            }
          }
        },
        {
          "kind": "condition",
          "ko": [
